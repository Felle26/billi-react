{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "shell:allow-execute",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow":[{ 
        "name": "bin/zugferd",
        "sidecar": true,
        "args": true
      }]
    }
  ]
}